from Jenga import *
from Jenga.GlobalToolchains import RegisterJengaGlobalToolchains

with workspace("Chapitre-6"):
    RegisterJengaGlobalToolchains()
    configurations(["Debug", "Release"])
    targetoses([TargetOS.WINDOWS])
    targetarchs([TargetArch.X86_64])
    useconfig("../../projet/Kit/R3D.jenga")

    with project("exo1-pointeur-capture"):
        windowedapp()
        language("C++")
        cppdialect("C++17")
        location("exo1-le_pointeur_capture")
        files(["pointeur.cpp"])
        user3d()

    with project("exo2-derive-provoquee"):
        consoleapp()
        language("C++")
        cppdialect("C++17")
        location("exo2-la_derive_provoquee")
        files(["derive.cpp"])
        user3d()
        linkoptions(["-Wl,--allow-multiple-definition"])
        postbuild([
            'powershell -NoProfile -ExecutionPolicy Bypass -File deploy_renderer_resources.ps1 "%{prj.targetdir}"'
        ])

    with project("exo3-accumuler-puis-vider"):
        consoleapp()
        language("C++")
        cppdialect("C++17")
        location("exo3-accumuler_puis_vider")
