        linkoptions(["-Wl,--allow-multiple-definition"])
        postbuild([
            'powershell -NoProfile -ExecutionPolicy Bypass -File "../exo2-la_derive_provoquee/deploy_renderer_resources.ps1" "%{prj.targetdir}"'
        ])

    with project("exo4-les-crochets-de-tests"):
        consoleapp()
        language("C++")
        cppdialect("C++17")
        location("exo4-les_crochets_de_tests")
        files(["tete.cpp"])
        user3d()
        linkoptions(["-Wl,--allow-multiple-definition"])
        postbuild([
            'powershell -NoProfile -ExecutionPolicy Bypass -File "../exo2-la_derive_provoquee/deploy_renderer_resources.ps1" "%{prj.targetdir}"'
        ])

    with project("exo5-les-deux-ordres-et-la-matrice"):
        consoleapp()
        language("C++")
        cppdialect("C++17")
        location("exo5-les_deux_ordres_et_la_matrice")
        files(["ordre.cpp"])
        user3d()
        linkoptions(["-Wl,--allow-multiple-definition"])
        postbuild([
            'powershell -NoProfile -ExecutionPolicy Bypass -File "../exo2-la_derive_provoquee/deploy_renderer_resources.ps1" "%{prj.targetdir}"'
        ])

